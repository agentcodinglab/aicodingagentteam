{
  "name": "aicodingagentteam-tui",
  "version": "0.1.0",
  "description": "Terminal UI client for AiCodingAgentTeam orchestration platform",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "aicodingagentteam-tui": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "proto/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "node scripts/e2e-live.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-coding",
